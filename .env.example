# Copy this file to `.env` and fill in your token.
ENTSOE_TOKEN=your-entsoe-token-here

# GIE AGSI+ gas storage — register at https://agsi.gie.eu/account
AGSI_KEY=your-agsi-key-here

# OPTIONAL — Terna inter-zonal flows (map arrows). Without these the map renders as usual.
# Register at https://developer.terna.it
TERNA_API_KEY=your-terna-client-id
TERNA_API_SECRET=your-terna-client-secret
